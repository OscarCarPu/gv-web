#!/bin/bash

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Pushing to main — deploying to lab-ocp.com..."
    ssh -T ocp@ssh.lab-ocp.com 'cd ~/docker/gv/gv-web && git pull && make up' 2>&1
    if [ $? -ne 0 ]; then
      echo "Deploy failed!"
      exit 1
    fi
    break
  fi
done
