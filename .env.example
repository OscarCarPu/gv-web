# API URL the browser hits — baked into the bundle at build time.
# Local: same host as the app. Production: the public API URL (e.g. https://api.example.com).
VITE_API_URL=http://localhost:8080

# API URL the SSR/server hits — read at runtime by the Node adapter.
# Docker compose: the gv-api service name. Bare-metal/prod: the internal/private API URL.
API_URL=http://gv-api:8080

# Public origin where this app is reachable — used by adapter-node for CSRF on POST forms.
# Must match the URL the browser uses, including scheme. Production: https://your-domain.example.com
ORIGIN=http://localhost:3000
