# API URL exposed to the browser (used by client-side code)
VITE_API_URL=http://localhost:8080
# API URL used by the server (used by server-side code, use Docker service name in production)
API_URL=http://gv-api:8080
# Public URL of this app (used by SvelteKit adapter-node for CSRF)
ORIGIN=http://localhost:3000
