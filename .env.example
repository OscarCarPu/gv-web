# API URL the browser hits — baked into the bundle at build time.
# Local: same host as the app. Production: the public API URL (e.g. https://api.example.com).
VITE_API_URL=http://localhost:8080

# API URL the SSR/server hits — read at runtime by the Node adapter.
# Docker compose: the gv-api service name. Bare-metal/prod: the internal/private API URL.
API_URL=http://gv-api:8080

# Public origin where this app is reachable — used by adapter-node for CSRF on POST forms.
# Must match the URL the browser uses, including scheme. Production: https://your-domain.example.com
ORIGIN=http://localhost:3000

# Max request body adapter-node will accept. The default is 512K, which rejects every real
# gcode upload on /printers. Not enforced by the Vite dev server — production only. If a
# reverse proxy sits in front, raise its limit too (nginx client_max_body_size defaults to 1M).
BODY_SIZE_LIMIT=256M

# --- Printers section (/printers) ---
# Camera: the printer's local RTSP stream, demuxed to MJPEG by ffmpeg server-side.
PRINTER_RTSP_URL=rtsp://192.168.1.211/live

# Local PrusaLink (Buddy firmware). Auth is HTTP Digest — user + password. Alternatively set
# PRUSALINK_API_KEY and it is sent as X-Api-Key instead.
PRUSALINK_HOST=http://192.168.1.235
PRUSALINK_USER=maker
PRUSALINK_PASSWORD=
# PRUSALINK_API_KEY=

# Storage that uploaded print files are written to. Leave unset to auto-detect from
# GET /api/v1/storage. On Buddy firmware this is 'usb' and needs a USB drive inserted —
# without one, uploads fail with 507.
PRUSALINK_STORAGE=

# Camera recordings. ffmpeg writes the RTSP stream here server-side, so a recording keeps
# running with the browser closed. Must be on a Docker volume or recordings die with the
# container — docker-compose.yml mounts one at this default path.
PRINTER_RECORDINGS_DIR=data/recordings
# Hard stop for a single recording, so one left running cannot fill the disk.
PRINTER_RECORDING_MAX_MINUTES=240
# Retention budget per printer. Oldest recordings are pruned to stay under it.
PRINTER_RECORDINGS_MAX_GB=10
# 'copy' muxes the camera's own H.264 with no re-encode. Only set a real encoder (libx264)
# if the camera's codec turns out to be something browsers will not play.
PRINTER_RECORDING_VIDEO_CODEC=copy
